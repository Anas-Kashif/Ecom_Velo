{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": ["node", "jest"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node10"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/__tests__/auth.test.ts", "src/__tests__/products.test.ts", "src/__tests__/orders.test.ts", "src/__tests__/users.test.ts"]
}