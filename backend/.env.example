# ========================================================
# Backend Environment Configuration Template
# Copy this file to .env or .env.local and fill in your values.
# NEVER COMMIT .env OR REAL CREDENTIALS TO VERSION CONTROL!
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL with Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/roady_ecom

# Authentication / Security
# Generate a strong 64-byte secret (e.g. node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_replace_in_production

# Email Configuration (Nodemailer with Gmail SMTP)
# For Gmail, create an App Password under Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_16_character_app_password
SEND_EMAILS=false

# Cloudinary Configuration (Product Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# HTTPS / SSL Configuration (Production Only)
HTTPS_ENABLED=false
HTTPS_PORT=443
HTTP_PORT=80
HTTPS_REDIRECT_HTTP=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Database Seeding (Development Only)
ALLOW_DEV_SEED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_secure_seed_password
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_ROLE=ADMIN
