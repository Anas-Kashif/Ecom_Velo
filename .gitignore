# ========================================================
# Root .gitignore for Velo E-Commerce Monorepo
# ========================================================

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
.env.staging
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Node Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs
dist/
build/
.next/
out/

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Cache & Temporary Files
.cache/
.turbo/
*.tsbuildinfo
.eslintcache

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
